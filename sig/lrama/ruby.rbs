module Lrama
  module Ruby
    VERSION: String

    class Error < StandardError
    end

    def self.parse: (Enumerable[[String | Symbol | Integer, untyped]] tokens, language: :ruby) -> Languages::Ruby::AST::Program

    def self.generate: (String source, ?filename: String, ?class_name: String, ?mode: (:parser | :recognizer), ?allow_error_rules: bool) -> String
    def self.compile: (String source, ?filename: String, ?class_name: String, ?mode: (:parser | :recognizer), ?allow_error_rules: bool) -> Class

    class Generator
      def initialize: () -> void
      def generate: (String source, ?filename: String, ?class_name: String, ?mode: (:parser | :recognizer), ?allow_error_rules: bool) -> String
    end

    module Languages
      module Ruby
        def self.parse: (Enumerable[[String | Symbol | Integer, untyped]] tokens) -> AST::Program

        class ParseError < ::Lrama::Ruby::Error
          attr_reader token: untyped
          attr_reader state: Integer
          def initialize: (untyped error) -> void
        end

        class UnsupportedSyntax < ::Lrama::Ruby::Error
          attr_reader rule: String
          attr_reader line: Integer
          def initialize: (String rule, Integer line) -> void
        end

        module AST
          type node = Literal | Binary | Unary | If | LocalRead | LocalWrite | BareCall | ArrayLiteral | HashLiteral | RangeLiteral
          type hash_pair = Pair

          class Program < ::Data
            attr_reader statements: Array[node]
            def self.new: (Array[node] statements) -> instance
                        | (statements: Array[node]) -> instance
          end

          class Literal < ::Data
            attr_reader value: Integer | Float | bool | nil
            def self.new: (Integer | Float | bool | nil value) -> instance
                        | (value: Integer | Float | bool | nil) -> instance
          end

          class Binary < ::Data
            attr_reader operator: Symbol
            attr_reader left: node
            attr_reader right: node
            def self.new: (Symbol operator, node left, node right) -> instance
                        | (operator: Symbol, left: node, right: node) -> instance
          end

          class Unary < ::Data
            attr_reader operator: Symbol
            attr_reader operand: node
            def self.new: (Symbol operator, node operand) -> instance
                        | (operator: Symbol, operand: node) -> instance
          end

          class If < ::Data
            attr_reader condition: node
            attr_reader then_body: Array[node]
            attr_reader else_body: Array[node]?
            def self.new: (node condition, Array[node] then_body, Array[node]? else_body) -> instance
                        | (condition: node, then_body: Array[node], else_body: Array[node]?) -> instance
          end

          class LocalRead < ::Data
            attr_reader name: Symbol
            def self.new: (Symbol name) -> instance
                        | (name: Symbol) -> instance
          end

          class LocalWrite < ::Data
            attr_reader name: Symbol
            attr_reader value: node
            def self.new: (Symbol name, node value) -> instance
                        | (name: Symbol, value: node) -> instance
          end

          class BareCall < ::Data
            attr_reader name: Symbol
            def self.new: (Symbol name) -> instance
                        | (name: Symbol) -> instance
          end

          class ArrayLiteral < ::Data
            attr_reader elements: Array[node]
            def self.new: (Array[node] elements) -> instance
                        | (elements: Array[node]) -> instance
          end

          class HashLiteral < ::Data
            attr_reader pairs: Array[Pair]
            def self.new: (Array[Pair] pairs) -> instance
                        | (pairs: Array[Pair]) -> instance
          end

          class Pair < ::Data
            attr_reader key: node
            attr_reader value: node
            def self.new: (node key, node value) -> instance
                        | (key: node, value: node) -> instance
          end

          class RangeLiteral < ::Data
            attr_reader operator: Symbol
            attr_reader begin_value: node
            attr_reader end_value: node
            def self.new: (Symbol operator, node begin_value, node end_value) -> instance
                        | (operator: Symbol, begin_value: node, end_value: node) -> instance
          end
        end
      end
    end
  end
end
