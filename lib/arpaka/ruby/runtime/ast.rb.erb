module AST
  Program = Data.define(:statements)
  Literal = Data.define(:value)
  EncodingLiteral = Data.define(:value)
<% if runtime.fetch("ast_nodes", []).include?("self") -%>
  Self = Data.define
<% end -%>
  Binary = Data.define(:operator, :left, :right)
  Unary = Data.define(:operator, :operand)
  If = Data.define(:condition, :then_body, :else_body)
  LocalRead = Data.define(:name)
  LocalWrite = Data.define(:name, :value)
<% if runtime.fetch("ast_nodes", []).include?("assignment") -%>
  Assignment = Data.define(:target, :value)
  OpAssign = Data.define(:target, :operator, :value)
  MultipleAssign = Data.define(:targets, :value)
  Field = Data.define(:receiver, :operator, :name)
  Alias = Data.define(:kind, :new_name, :old_name)
  Undef = Data.define(:names)
<% end -%>
  BareCall = Data.define(:name)
  ArrayLiteral = Data.define(:elements)
  Splat = Data.define(:value)
  HashLiteral = Data.define(:pairs)
<% if runtime.fetch("ast_nodes", []).include?("keyword_arguments") -%>
  KeywordArguments = Data.define(:pairs)
<% end -%>
  Pair = Data.define(:key, :value)
  RangeLiteral = Data.define(:operator, :begin_value, :end_value)
  Ternary = Data.define(:condition, :then_value, :else_value)
  Call = Data.define(:name, :arguments)
  Super = Data.define(:arguments)
  BlockPass = Data.define(:arguments, :value)
  ReceiverCall = Data.define(:receiver, :operator, :name, :arguments)
  BlockParameters = Data.define(:kind, :value)
  Parameter = Data.define(:kind, :name, :value)
  BlockCall = Data.define(:call, :parameters, :body)
  StringLiteral = Data.define(:value)
  InterpolatedString = Data.define(:parts)
  DynamicSymbol = Data.define(:parts)
  Index = Data.define(:receiver, :arguments)
  Loop = Data.define(:kind, :condition, :body)
  Control = Data.define(:kind, :value)
  Variable = Data.define(:kind, :name)
  ConstantPath = Data.define(:receiver, :name)
  AbsoluteConstant = Data.define(:name)
  Rescue = Data.define(:expression, :fallback)
  RegexpLiteral = Data.define(:value, :options, :encoding, :once) do
    constructor = method(:new)
    define_singleton_method(:new) do |value, options = 0, encoding = nil, once = false|
      constructor.call(value, options, encoding, once)
    end
  end
  XStringLiteral = Data.define(:value)
  For = Data.define(:variable, :enumerable, :body)
  Def = Data.define(:name, :arguments, :body)
<% if runtime.fetch("ast_nodes", []).include?("singleton_method") -%>
  SingletonMethodDef = Data.define(:receiver, :name, :arguments, :body)
<% end -%>
  ClassDef = Data.define(:name, :superclass, :body)
  ModuleDef = Data.define(:name, :body)
<% if runtime.fetch("ast_nodes", []).include?("singleton_class") -%>
  SingletonClassDef = Data.define(:receiver, :body)
<% end -%>
  When = Data.define(:patterns, :body)
  Case = Data.define(:expression, :whens, :else_body)
<% if runtime.fetch("ast_nodes", []).include?("pattern") -%>
  Pattern = Data.define(:kind, :values)
  RescueClause = Data.define(:exceptions, :variable, :body)
  FullRescue = Data.define(:body, :clauses, :else_body, :ensure_body)
  BeginBlock = Data.define(:body)
  EndBlock = Data.define(:body)
<% end -%>
  Lambda = Data.define(:arguments, :body)
  Sequence = Data.define(:statements)
end
