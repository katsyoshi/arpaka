class Error < StandardError; end

class ParseError < Error
  attr_reader :token, :state

  def initialize(error)
    @token, @state = error.token, error.state
    super(error.message)
  end
end

class UnsupportedSyntax < Error
  attr_reader :rule, :line

  def initialize(rule, line)
    @rule, @line = rule, line
    super("Unsupported syntax: #{rule} (upstream parse.y:#{line})")
  end
end

class LexerError < Error; end

def self.parse(source, filename: "(ruby)")
  lexer = Lexer.new(source, filename: filename)
  result = parse_tokens(lexer.each, lexical_context: lexer.context, source_encoding: lexer.source_encoding)
<% if ast_type == :structured -%>
  detailed_ast, modifier_if_nodes = result
  AST.project(detailed_ast, filename: filename, modifier_if_nodes: modifier_if_nodes)
<% else -%>
  result
<% end -%>
end

def self.parse_tokens(tokens, lexical_context: nil, source_encoding: Encoding::UTF_8.name)
  parser = Parser.new
  builder = Builder.new
  builder.instance_variable_set(:@source_encoding, source_encoding)
  parser.instance_variable_set(:@builder, builder)
  parser.lexical_context = lexical_context
  result = parser.parse(tokens)
<% if ast_type == :structured -%>
  [result, builder.modifier_if_nodes]
<% else -%>
  result
<% end -%>
rescue Parser::ParseError => error
  raise ParseError.new(error)
end
private_class_method :parse_tokens
private_constant :Parser
